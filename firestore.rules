rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Exercise definitions are application-owned catalog data. The browser may
    // query them after login, but only trusted IAM tooling can seed or update
    // the collection because server credentials bypass client Security Rules.
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Leaderboard and Compare still query this collection. Reads therefore
    // remain authenticated-user-wide until public ranking fields are split from
    // private profile data; writes are restricted to the owner or admin claim.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(uid) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
